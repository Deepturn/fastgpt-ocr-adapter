# ---------- 镜像 ----------
# 适配器镜像。客户使用自己的镜像仓库时只改这一项。
FASTGPT_OCR_ADAPTER_IMAGE=crpi-g79ks4g398u6l56b.cn-hangzhou.personal.cr.aliyuncs.com/fastgpt-ocr-adapter/adapter:0.1.0
# MinerU Core 镜像。也可以改成客户自己的 ACR/私有仓库地址。
MINERU_CORE_IMAGE=ghcr.io/deepturn/fastgpt-mineru-core:3.4.4-cu129

# ---------- 适配器鉴权 ----------
# 生成方式：openssl rand -hex 32
FASTGPT_OCR_AUTH_TOKEN=replace-with-a-random-token
FASTGPT_OCR_REQUIRE_AUTH=true

# ---------- 解析限制 ----------
FASTGPT_OCR_TIMEOUT_SECONDS=540
FASTGPT_OCR_MAX_FILE_BYTES=52428800
FASTGPT_OCR_MAX_PAGES=500

# ---------- 并发与排队 ----------
# 默认单 GPU 安全值。只有确认上游可并发时才提高。
FASTGPT_OCR_MAX_CONCURRENT_REQUESTS=1
FASTGPT_OCR_MAX_QUEUED_REQUESTS=1
FASTGPT_OCR_QUEUE_TIMEOUT_SECONDS=60

# ---------- Provider ----------
FASTGPT_OCR_PROVIDER=mineru
FASTGPT_OCR_API_PROFILE=mineru-api-v3
FASTGPT_OCR_PROVIDER_VERSION=3.4.4

# ---------- 对外端口 ----------
# FastGPT 与适配器在同一台机器时保持 127.0.0.1。
# FastGPT 在其他机器时改成服务器私网 IP，并用防火墙限制来源。
FASTGPT_OCR_BIND=127.0.0.1
FASTGPT_OCR_PORT=8001

# ---------- 容器资源与临时空间 ----------
FASTGPT_OCR_CPU_LIMIT=1
FASTGPT_OCR_MEMORY_LIMIT=512m
FASTGPT_OCR_TMPFS_SIZE=256m
MINERU_CORE_CPU_LIMIT=8
MINERU_CORE_MEMORY_LIMIT=24g
MINERU_TMPFS_SIZE=2g
MINERU_OUTPUT_TMPFS_SIZE=8g
MINERU_SHM_SIZE=16gb
MINERU_HEALTHCHECK_START_PERIOD=10m
MINERU_MODELS_VOLUME=fastgpt-ocr-mineru-models

# ---------- MinerU Core ----------
MINERU_API_MAX_CONCURRENT_REQUESTS=1
MINERU_API_TASK_RETENTION_SECONDS=900
MINERU_PROCESSING_WINDOW_SIZE=1
